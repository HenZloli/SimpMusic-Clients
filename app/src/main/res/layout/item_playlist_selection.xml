<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp">

    <FrameLayout
        android:layout_width="48dp"
        android:layout_height="48dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivSelectionPlaylistCover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.MaterialComponents.SmallComponent"
            tools:src="@drawable/ic_library" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/layoutSelectionPlaylistCoverGrid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            app:cardCornerRadius="4dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:columnCount="2"
                android:rowCount="2">

                <ImageView
                    android:id="@+id/ivSelectionGrid1"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:scaleType="centerCrop" />

                <ImageView
                    android:id="@+id/ivSelectionGrid2"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:scaleType="centerCrop" />

                <ImageView
                    android:id="@+id/ivSelectionGrid3"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:scaleType="centerCrop" />

                <ImageView
                    android:id="@+id/ivSelectionGrid4"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:scaleType="centerCrop" />
            </GridLayout>
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>

    <TextView
        android:id="@+id/tvSelectionPlaylistName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        tools:text="Tên Playlist" />

</LinearLayout>